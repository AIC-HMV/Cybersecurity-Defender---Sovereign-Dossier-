# CEA Blocklist Updater SystemD Service
# Author: Hung Minh Vo (Austin) — CEA Supreme Commander
# Seal: HMV-SOV-20251003-ALL

[Unit]
Description=CEA Blocklist Updater Service
Documentation=https://github.com/AIC-HMV/Cybersecurity-Defender---Sovereign-Dossier-
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cea/services
ExecStart=/usr/bin/python3 /opt/cea/services/blocklist_updater.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target

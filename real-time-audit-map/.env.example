# Real-Time Audit Map Configuration
# Copy this file to .env and fill in your values

# Database connection
AUDIT_DB_URL=postgresql://audituser:auditpass@localhost:5432/auditdb

# MaxMind GeoIP database path
# Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
MAXMIND_DB_PATH=/data/GeoLite2-City.mmdb

# OpenWeatherMap API key (leave blank to disable weather lookups)
# Get free key at https://openweathermap.org/api
OPENWEATHER_KEY=

# Mapbox token (leave blank to use MapLibre GL)
# Get free token at https://www.mapbox.com/
MAPBOX_TOKEN=

# Server configuration
POLL_INTERVAL=5          # Poll database every N seconds
WEATHER_CACHE_TTL=300    # Cache weather data for N seconds
WS_PORT=8765            # WebSocket port
HTTP_PORT=8080          # HTTP server port

# Security (optional)
# API_KEY=your_api_key_for_websocket_auth
# ALLOWED_IPS=127.0.0.1,192.168.1.0/24
